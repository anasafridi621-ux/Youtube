# =============================================================================
# YouTube Bulk Scheduler - environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Every value below is a placeholder. No real secrets appear in this file.
#
# The app refuses to boot without OWNER_EMAIL and Google OAuth credentials;
# everything else degrades gracefully and is reported on the dashboard.
# =============================================================================

# ----------------------------------------------------------------- APP / URL
# The public URL of THIS deployment. Used to build the Google OAuth redirect
# URI automatically. Change it when you move from localhost to Render/Railway
# and add the matching origin + redirect URI in Google Cloud Console.
APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=YouTube Bulk Scheduler

# --------------------------------------------------------- OWNER (single)
# Comma-separated allowlist of Google accounts allowed to sign in.
# Only these addresses can reach the dashboard. Not exposed to the browser.
OWNER_EMAIL=your-google-address@example.com

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random per-process key is used and every restart logs you out.
ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
SECURE_COOKIES=false

# ------------------------------------------------------------------ DATABASE
DATABASE_PATH=./data/scheduler.db

# ------------------------------------------------------------------- STORAGE
UPLOAD_DIR=./data/uploads
DERIVED_DIR=./data/derived
LOG_DIR=./logs
MAX_UPLOAD_BYTES=4294967296
LOCAL_FREE_WARN_BYTES=5368709120

# ----------------------------------------------------------------- TIMEZONE
# MASTER timezone. All scheduling math happens here. IANA name, never a
# hard-coded UTC offset, so EST/EDT changes are handled automatically.
TIMEZONE=America/New_York
# Extra zones shown alongside ET in the dashboard (comma-separated).
DISPLAY_TIMEZONES=America/New_York,Asia/Kolkata

# --------------------------------------------------------------- SCHEDULE
# Exactly 5 videos every single day, no weekend exceptions.
DAILY_VIDEO_COUNT=5
# The five daily publishing times in America/New_York.
PUBLISH_SLOT_TIMES=08:00,14:00,16:00,18:00,20:00
# Never fill a slot that starts within this many minutes.
SLOT_LEAD_MINUTES=5
# Rolling advance buffer: how many days ahead are fully prepared.
ADVANCE_BUFFER_DAYS=1
# Hard ceiling on videos actively AI-processed at once (today + buffer).
MAX_ACTIVE_VIDEOS=10

# =============================================================================
# AI PROVIDERS - 4 metadata models, strict sequential fallback
# =============================================================================
# Order:  Gemini -> OpenRouter #1 -> OpenRouter #2 -> OpenRouter #3
# The names below are EXAMPLES ONLY. Nothing is hard-coded in application
# logic: set whatever free models you want and the chain follows your config.

# ---------------------------------------------------------------- 1. GEMINI
# Google AI Studio key. Free tier is sufficient.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------- 2-4. OPENROUTER FREE FALLBACKS
# Each fallback needs BOTH a key and a model. All three must be free models.
# OPENROUTER_FREE_ONLY=true rejects any model that is not free, so a paid
# model can never be selected by accident.
OPENROUTER_FREE_ONLY=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_RETRIES=2

OPENROUTER_API_KEY_1=
OPENROUTER_MODEL_1=deepseek/deepseek-chat-v3.1:free

OPENROUTER_API_KEY_2=
OPENROUTER_MODEL_2=qwen/qwen3-coder:free

OPENROUTER_API_KEY_3=
OPENROUTER_MODEL_3=meta-llama/llama-3.3-70b-instruct:free

# Shared AI behaviour
AI_TIMEOUT_MS=90000
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=2048
# Frames sent to the model for video understanding. Kept small on purpose.
ANALYSIS_FRAMES=4
ANALYSIS_FRAME_WIDTH=512
ANALYSIS_JPEG_QUALITY=72
AI_SEND_FRAMES=true
AI_MAX_ROUNDS=3
AI_RETRY_BACKOFF_MS=15000

# =============================================================================
# THUMBNAIL - a SEPARATE provider from the four metadata models
# =============================================================================
# openrouter | gemini | pollinations | none
# If the provider fails, rate-limits or returns an unusable image, the system
# automatically falls back to the best real frame from the MP4. It never makes
# a paid API call to recover a thumbnail.
THUMBNAIL_PROVIDER=none
THUMBNAIL_PROVIDER_KEY=
THUMBNAIL_PROVIDER_MODEL=
THUMBNAIL_FREE_ONLY=true
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720
THUMBNAIL_TIMEOUT_MS=90000
THUMBNAIL_MAX_RETRIES=2

# =============================================================================
# GOOGLE / YOUTUBE
# =============================================================================
# OAuth Web client from Google Cloud Console (project: YouTube Shorts Auto
# Scheduler / precise-mystery-509108-q1). Add this app's origin and redirect
# URI to the client's authorized origins / redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/auth/google/callback - override if you need to.
GOOGLE_REDIRECT_URI=
# Server-side token store. Gitignored, 0600, never sent to the browser.
GOOGLE_TOKEN_FILE=./config/tokens.json
# Optional: a public API key for read-only calls. Not required for uploads.
YOUTUBE_API_KEY=

# YouTube video defaults
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=24
YOUTUBE_DEFAULT_LANGUAGE=en
YOUTUBE_UPLOAD_RETRIES=1
YOUTUBE_UPLOAD_TIMEOUT_MS=900000

# Made for Kids: leave blank to read the channel's live setting at startup and
# honour it. Set true/false only if you deliberately want to override.
YOUTUBE_MADE_FOR_KIDS=

# Altered / synthetic media disclosure.
#   auto   = the model decides per video and reports its confidence
#   true   = always disclose
#   false  = never disclose
# Nothing is silently hard-coded; verify against your channel's configuration.
SYNTHETIC_MEDIA_DISCLOSURE=auto

# Optional operator guard on videos.insert calls per day. 0 = disabled.
# NOTE: no per-call cost is assumed anywhere in this codebase. Current
# YouTube documentation moved videos.insert into its own quota bucket, so the
# old 1,600-unit figure is obsolete and is deliberately not used.
YOUTUBE_DAILY_INSERT_SOFT_CAP=0

# =============================================================================
# GOOGLE DRIVE (optional storage layer)
# =============================================================================
# Narrowest scope: drive.file - the app only sees files it created itself.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=

# =============================================================================
# STORAGE CLEANUP
# =============================================================================
# Delete the source MP4 from local storage AND Google Drive after the YouTube
# schedule is CONFIRMED. Default ON.
DELETE_AFTER_SUCCESSFUL_YOUTUBE_SCHEDULE=true
# Minimum hours between confirmation and deletion (lets retries/reconciliation
# finish safely).
DELETE_DELAY_HOURS=6
# Hard ceiling. The requirement is "within 24 hours".
DELETE_MAX_HOURS=24

# =============================================================================
# WORKER
# =============================================================================
WORKER_CONCURRENCY=1
WORKER_POLL_MS=5000
QUEUE_SWEEP_MS=60000
CLEANUP_SWEEP_MS=900000
PROVIDER_HEALTH_MS=300000

# =============================================================================
# TREND / SEARCH RESEARCH (optional, additive)
# =============================================================================
# Never used to decide WHAT to create. Only supplies discoverability wording.
# Never claims anything is "trending" without real data. Disabled by default.
TRENDS_ENABLED=false
TRENDS_PROVIDER=none
TRENDS_API_KEY=
TRENDS_TIMEOUT_MS=15000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# OPTIONAL: override the FFmpeg binaries
# =============================================================================
# Resolution order: these env vars -> system ffmpeg/ffprobe on PATH ->
# the bundled @ffmpeg-installer/<platform> package. Leave blank to auto-detect.
FFMPEG_PATH=
FFPROBE_PATH=

# =============================================================================
# LEGACY AGENTTUBE (optional - only if you still run `npm run legacy`)
# =============================================================================
# The original autonomous content-generation app is untouched and still runs
# from `node index.js`. These variables are only read by that legacy path.
# Remove this whole block if you never use the legacy app.
# GLOBAL_RATE_LIMIT_PER_HOUR=
# RETRY_ATTEMPTS=
# DEFAULT_DELAY_BETWEEN_POSTS=
# UPLOAD_PATH=
# ANALYTICS_DB_PATH=
